{
    "name": "obsidian-plugin-s3-link",
    "version": "1.6.3",
    "description": "Obsidian plugin for including S3 links in notes",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "version": "node version-bump.mjs && git add manifest.json versions.json"
    },
    "keywords": [
        "obsidian",
        "obsidian-plugin",
        "s3",
        "aws"
    ],
    "author": {
        "name": "Michael Wiesendanger",
        "email": "michael.wiesendanger@gmail.com",
        "url": "https://github.com/RagedUnicorn"
    },
    "homepage": "https://github.com/RagedUnicorn/obsidian-plugin-s3-link",
    "license": "MIT",
    "devDependencies": {
        "@types/jest": "^29.5.3",
        "@types/node": "^16.11.6",
        "@typescript-eslint/eslint-plugin": "5.29.0",
        "@typescript-eslint/parser": "5.29.0",
        "builtin-modules": "3.3.0",
        "esbuild": "0.17.3",
        "jest": "^29.6.2",
        "jest-environment-jsdom": "^29.6.2",
        "obsidian": "latest",
        "ts-jest": "^29.1.1",
        "tslib": "2.4.0",
        "typescript": "4.7.4"
    },
    "dependencies": {
        "cos-js-sdk-v5": "^1.10.1"
    },
    "jest": {
        "transform": {
            "^.+\\.tsx?$": "ts-jest"
        },
        "testEnvironment": "jest-environment-jsdom",
        "setupFiles": [
            "<rootDir>/test/mock/setup.ts"
        ],
        "testRegex": "(/test/.*|(\\.|/)(test|spec))\\.tsx?$",
        "testPathIgnorePatterns": [
            "/node_modules/",
            "/test/mock/"
        ],
        "moduleNameMapper": {
            "^obsidian$": "<rootDir>/test/mock/obsidianMock.ts"
        },
        "moduleFileExtensions": [
            "ts",
            "tsx",
            "js",
            "jsx",
            "json",
            "node"
        ]
    }
}
